  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "*",
    "@types/express": "*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "*",
    "@types/node": "*",
